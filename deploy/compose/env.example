# Copy to ".env" next to docker-compose.yml, fill in, and keep it to root: chmod 600 .env
# Values are taken as written: no quotes, no spaces around "=".

# ── imageBio ────────────────────────────────────────────────────────────────────
IMAGEBIO_VERSION=0.1.0
# The name users type in their browser (the certificate is for this name).
IMAGEBIO_HOST=imagebio.lab.example
# Certificate: "internal" (made by Caddy: browsers warn until its authority is installed),
# or two files mounted in the caddy service, e.g. "/certs/fullchain.pem /certs/privkey.pem",
# or an e-mail address, for a public name: Caddy then asks Let's Encrypt.
IMAGEBIO_TLS=internal
# Ports of this machine, when 80 and 443 are taken (users then type https://name:port).
# IMAGEBIO_HTTP_PORT=80
# IMAGEBIO_HTTPS_PORT=443
# The account the server runs as: it must be able to READ the data. id -u / id -g of that account.
IMAGEBIO_UID=10001
IMAGEBIO_GID=10001
# Directories of the host. The data are mounted read-only. The two others must exist and
# belong to the account above:  install -d -o UID -g GID -m 0750 /var/lib/imagebio /var/backups/imagebio
IMAGEBIO_DATA=/srv/microscope
IMAGEBIO_STATE=/var/lib/imagebio
IMAGEBIO_BACKUPS=/var/backups/imagebio
# What the proxy presents to the server with every request, so that nobody else on this
# machine can pass for a user. Generate it:  openssl rand -hex 32
IMAGEBIO_PROXY_SECRET=
# Optional. A monitoring system on the "app" network reads http://imagebio:8000/metrics with
# "Authorization: Bearer <this>". Generate it the same way.
IMAGEBIO_METRICS_TOKEN=
# Optional. Password of the mail relay, when [alerts.smtp] names it with password_env.
IMAGEBIO_SMTP_PASSWORD=

# ── single sign-on only (docker-compose.sso.yml) ────────────────────────────────
# COMPOSE_FILE=docker-compose.yml:docker-compose.sso.yml
# Take the current stable release of oauth2-proxy and read its notes.
OAUTH2_PROXY_VERSION=v7.8.1
# The OpenID Connect provider of the institute (Keycloak, Entra ID, ...). The client must
# allow the redirection address https://<IMAGEBIO_HOST>/oauth2/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# "groups" only if the provider has such a scope and puts the groups in the token.
OIDC_SCOPE=openid email profile
# 32 bytes:  openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
