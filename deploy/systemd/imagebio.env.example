# /etc/imagebio/imagebio.env  (chown root:imagebio, chmod 640)
# What the proxy presents with every request (the same value goes into /etc/imagebio/proxy.env
# for Caddy). Generate it:  openssl rand -hex 32
IMAGEBIO_PROXY_SECRET=
# Optional: lets a monitoring system on another machine read /metrics with
# "Authorization: Bearer <this>" (the proxy must then let /metrics through for it).
# IMAGEBIO_METRICS_TOKEN=
# Optional: password of the mail relay, when [alerts.smtp] names it with password_env.
# IMAGEBIO_SMTP_PASSWORD=
